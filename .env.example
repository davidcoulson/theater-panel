# Theater panel settings. Copy to .env and fill in.
#
# With docker compose this file is also Compose's interpolation file, so a literal $ in a token
# or password must be written $$ (compose turns $$ back into $ before the container sees it).

PORT=8787

# Traefik: the hostname the panel is served at, and how your Traefik is set up.
PANEL_HOST=ht-kiosk.coulson.io
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Leave empty when Traefik already serves a wildcard certificate for the domain.
TRAEFIK_CERTRESOLVER=

# Origins allowed to show the panel in a frame: Home Assistant's Webpage dashboard.
FRAME_ANCESTORS=https://home-iot.coulson.io
# Shared key: clients open the panel once with ?key=<value> and keep a cookie. Empty = the panel
# makes one on first run and shows it on /admin (it is saved with the settings in /data).
PANEL_KEY=
# 1 = the network is trusted: no key is made and a saved one stops being enforced.
ALLOW_OPEN=
# Addresses that skip the key (the wall panel, the house LAN), comma-separated CIDRs. Empty = none.
TRUST_NETWORKS=
# Proxies whose X-Forwarded-For is believed. Default: Docker's own networks (127.0.0.1,::1,172.16.0.0/12);
# add Traefik or the k3s ingress if the panel is reached through one.
TRUSTED_PROXIES=

# Home Assistant: a long-lived access token, ideally from a dedicated non-admin user.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Plex Media Server and a token for it.
PLEX_URL=http://plex.local:32400
PLEX_TOKEN=
# Library tabs, in order (titles as they appear in Plex). Empty = all movie and TV libraries.
PLEX_LIBRARIES=4K Movies,Movies,TV Shows
# The Apple TV's name in Plex (for Showtime artwork). Empty = first playing session.
PLEX_PLAYER_NAME=

# Whose watch history feeds "You'll love this" and the Mystery box: Plex account names (or ids).
# Empty follows the whole house.
HISTORY_ACCOUNTS=

# Pre-roll: a deep swell on the theater speakers while the lights go down, before the film. Must
# be a URL the speaker itself can fetch; the panel serves its own at /assets/preroll.mp3 with no
# key needed. Empty turns it off. Films only unless PREROLL_MOVIES_ONLY=false.
PREROLL_URL=
PREROLL_SECONDS=16
PREROLL_MOVIES_ONLY=true

# Poster labels: quality badges (4K / HDR / Atmos) on by default; network labels off by
# default because Kometa-decorated posters already show the network.
SHOW_QUALITY_BADGES=true
SHOW_NETWORK_BADGES=false

# Games screen: Steam Web API key (steamcommunity.com/dev/apikey) and your 64-bit SteamID.
STEAM_API_KEY=
STEAM_ID=

# Seerr (Overseerr / Jellyseerr).
SEERR_URL=http://seerr.local:5055
SEERR_API_KEY=
# What the Scan to request QR opens on a guest's phone (blank = SEERR_URL).
SEERR_PUBLIC_URL=

# TMDB, for the holiday shelves: a free API key (themoviedb.org > Settings > API) and the number
# of a public list per season from its address on themoviedb.org. Blank = Kometa's collections.
TMDB_API_KEY=
TMDB_LIST_HALLOWEEN=7061968
TMDB_LIST_CHRISTMAS=5915
# Optional Seerr user id to request as (instead of the API key's owner).
SEERR_USER_ID=
# Region for "streaming on" lookups.
SEERR_REGION=US

# Room entities.
ENTITY_APPLE_TV=media_player.home_theater
ENTITY_APPLE_TV_REMOTE=remote.home_theater
# Plex client for the Apple TV (appears after enabling "Advertise as player" and scanning clients).
ENTITY_PLEX_PLAYER=
# Projector Android Debug Bridge media_player, once ADB is set up.
ENTITY_PROJECTOR=
# The projector's own Plex client, as HA's Plex integration names it (for PLAY_TARGET=plex).
ENTITY_PROJECTOR_PLEX_PLAYER=
ENTITY_LIGHTS=light.media_room_downlights,light.home_theater_accent_lights,light.home_theater_wled
ENTITY_MUSIC_PLAYER=media_player.home_theater_2
# Music Assistant players offered under "Play on" (first = the theater's own).
ENTITY_MUSIC_PLAYERS=media_player.home_theater_2
ENTITY_TEMPERATURE=sensor.media_room_temperature
ENTITY_OCCUPANCY=binary_sensor.media_room_occupancy
# Tautulli's "watching" sensor, for the Stats screen.
ENTITY_TAUTULLI=sensor.tautulli_watching
# input_number helpers for accent-light effect speed and intensity, shown in the effect picker.
ENTITY_ACCENT_SPEED=input_number.home_theater_accent_speed
ENTITY_ACCENT_INTENSITY=input_number.home_theater_accent_intensity
# input_select helper the projector card shows and cycles for picture mode.
ENTITY_PICTURE_MODE=input_select.projector_picture_mode
# Favourite light effects shown first in the Moods sheet (up to 8, comma-separated, in order).
ACCENT_FAVOURITES=

# Poster cache size.
IMAGE_CACHE_MB=512

# Apps on the Projector card (Name=package, comma-separated); they open on the projector over ADB
PROJECTOR_APPS=Plex=com.plexapp.android

# Minutes without a touch before the panel drifts to the Now Showing screen (0 = never).
IDLE_MINUTES=8
# How far back the "Now in Plex" chip looks for requests that arrived (hours, at most 14 days).
ARRIVAL_HOURS=48

# Turns on the settings page at /admin
ADMIN_PASSWORD=

# Where Play starts: appletv (default, the Apple TV's Plex app), plezy (Plezy on the projector,
# opened with a plezy:// link over ADB) or plex (the official Plex app on the projector).
# "projector" still works as the old name for plezy.
PLAY_TARGET=
# Android package names of those two projector apps, if yours differ.
PLEZY_PACKAGE=com.edde746.plezy
PROJECTOR_PLEX_PACKAGE=com.plexapp.android
