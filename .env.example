# Theater panel settings. Copy to .env and fill in.

PORT=8787

# Traefik: the hostname the panel is served at, and how your Traefik is set up.
PANEL_HOST=ht-kiosk.coulson.io
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Leave empty when Traefik already serves a wildcard certificate for the domain.
TRAEFIK_CERTRESOLVER=

# Origins allowed to show the panel in a frame: Home Assistant's Webpage dashboard.
FRAME_ANCESTORS=https://home-iot.coulson.io
# Optional: require ?key=<value> once per device (then remembered by cookie).
PANEL_KEY=

# Home Assistant: a long-lived access token, ideally from a dedicated non-admin user.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Plex Media Server and a token for it.
PLEX_URL=http://plex.local:32400
PLEX_TOKEN=
# Library tabs, in order (titles as they appear in Plex). Empty = all movie and TV libraries.
PLEX_LIBRARIES=4K Movies,Movies,TV Shows
# The Apple TV's name in Plex (for Showtime artwork). Empty = first playing session.
PLEX_PLAYER_NAME=

# Poster labels: quality badges (4K / HDR / Atmos) on by default; network labels off by
# default because Kometa-decorated posters already show the network.
SHOW_QUALITY_BADGES=true
SHOW_NETWORK_BADGES=false

# Games screen: Steam Web API key (steamcommunity.com/dev/apikey) and your 64-bit SteamID.
STEAM_API_KEY=
STEAM_ID=

# Seerr (Overseerr / Jellyseerr).
SEERR_URL=http://seerr.local:5055
SEERR_API_KEY=
# Optional Seerr user id to request as (instead of the API key's owner).
SEERR_USER_ID=
# Region for "streaming on" lookups.
SEERR_REGION=US

# Room entities.
ENTITY_APPLE_TV=media_player.home_theater
ENTITY_APPLE_TV_REMOTE=remote.home_theater
# Plex client for the Apple TV (appears after enabling "Advertise as player" and scanning clients).
ENTITY_PLEX_PLAYER=
# Projector Android Debug Bridge media_player, once ADB is set up.
ENTITY_PROJECTOR=
ENTITY_LIGHTS=light.media_room_downlights,light.home_theater_accent_lights,light.home_theater_wled
ENTITY_MUSIC_PLAYER=media_player.home_theater_2
# Music Assistant players offered under "Play on" (first = the theater's own).
ENTITY_MUSIC_PLAYERS=media_player.home_theater_2
ENTITY_TEMPERATURE=sensor.media_room_temperature
ENTITY_OCCUPANCY=binary_sensor.media_room_occupancy

# Poster cache size.
IMAGE_CACHE_MB=512

# Apps on the Projector card (Name=package, comma-separated); they open on the projector over ADB
PROJECTOR_APPS=Plex=com.plexapp.android

# Turns on the settings page at /admin
ADMIN_PASSWORD=

# Where Play starts: appletv (default) or projector (the Plex client on the projector, over ADB)
PLAY_TARGET=
